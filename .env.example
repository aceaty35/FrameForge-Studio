# GEMINI_API_KEY: Server-only secret (never prefix with NEXT_PUBLIC_).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical HTTPS URL where this applet is deployed.
# Used at build time for sitemap.xml, robots.txt, and canonical OpenGraph metadata.
APP_URL="https://frameforge.studio"

# NEXT_OUTPUT_MODE: Controls Next.js compilation target in next.config.ts.
# - "standalone" (default): Node/Container/Vercel server output (.next/standalone) with native HTTP headers().
# - "export": 100% static HTML/JS/WASM export (out/) for Cloudflare Pages, Netlify, or GitHub Pages.
NEXT_OUTPUT_MODE="standalone"

# NEXT_PUBLIC_FFMPEG_CORE_BASE_URL: Non-secret URL prefix for @ffmpeg/core@0.12.6 assets (ffmpeg-core.js & ffmpeg-core.wasm).
# Defaults to https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd with automatic fallback to https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.6/dist/umd.
# Set to "/ffmpeg" if self-hosting compressed WASM binaries inside public/ffmpeg/.
NEXT_PUBLIC_FFMPEG_CORE_BASE_URL="https://unpkg.com/@ffmpeg/core@0.12.6/dist/umd"

# NEXT_PUBLIC_ENABLE_COOP_COEP: Non-secret boolean flag ("true" | "false").
# Set to "true" on dedicated top-level HTTPS origins to emit Cross-Origin-Opener-Policy: same-origin
# and Cross-Origin-Embedder-Policy: credentialless (enables SharedArrayBuffer multi-threading).
# Keep "false" (default) when embedding in preview iframes or loading cross-origin non-CORP assets.
NEXT_PUBLIC_ENABLE_COOP_COEP="false"

